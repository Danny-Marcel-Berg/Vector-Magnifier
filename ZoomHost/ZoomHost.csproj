<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest Condition="'$(EnableUiAccess)' != 'true'">app.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(EnableUiAccess)' == 'true'">app.uiaccess.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.D3DCompiler" Version="3.*" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.*" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.*" />
    <PackageReference Include="Vortice.DXGI" Version="3.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shader source; compiled at first start and cached per source hash. -->
    <EmbeddedResource Include="Shaders\EdgeSmoothing.hlsl" LogicalName="ZoomHost.Shaders.EdgeSmoothing.hlsl" WithCulture="false" />
  </ItemGroup>

</Project>
